{
  "name": "OnaFlix Admin Panel",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    },
    "ghcr.io/devcontainers-extra/features/postgresql-client:1": {}
  },
  "forwardPorts": [5000, 5432],
  "portsAttributes": {
    "5000": {
      "label": "Flask App",
      "onAutoForward": "notify"
    },
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "ignore"
    }
  },
  "postCreateCommand": "pip install --no-cache-dir -r requirements.txt",
  "containerEnv": {
    "FLASK_APP": "run.py",
    "FLASK_ENV": "development",
    "SQLALCHEMY_DATABASE_URI": "postgresql://gitpod:gitpod@localhost:5432/onaflix_admin"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"]
      }
    }
  }
}
