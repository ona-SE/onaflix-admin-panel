{
  "name": "OnaFlix Admin Panel",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/itsmechlark/features/postgresql:1": {
      "version": "15"
    }
  },
  "postCreateCommand": "pip install --no-cache-dir -r requirements.txt && sudo -u postgres psql -c \"CREATE USER gitpod WITH PASSWORD 'gitpod' CREATEDB;\" || true && sudo -u postgres createdb -O gitpod onaflix_admin || true",
  "forwardPorts": [5000, 5432],
  "portsAttributes": {
    "5000": {
      "label": "Flask App",
      "onAutoForward": "notify"
    },
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"]
      }
    }
  },
  "containerEnv": {
    "FLASK_APP": "run.py",
    "FLASK_DEBUG": "1",
    "SQLALCHEMY_DATABASE_URI": "postgresql://gitpod:gitpod@localhost:5432/onaflix_admin"
  }
}
